# Target: an organization or a single repository
GITHUB_URL=https://github.com/my-org
# GITHUB_URL=https://github.com/my-org/my-repo

# PAT with admin:org (organization) or repo (repository) scope
GITHUB_PAT=ghp_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional
RUNNER_NAME=
RUNNER_LABELS=docker,linux
RUNNER_GROUP=
RUNNER_EPHEMERAL=false
